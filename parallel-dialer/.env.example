# Twilio — Main credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio — API Key (needed for browser softphone token)
# Create at: Twilio Console → Account → API Keys → Create API Key
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# Twilio — TwiML App (needed for browser softphone)
# Create at: Twilio Console → Voice → TwiML Apps → Create
# Set the Voice Request URL to: https://your-ngrok-url.ngrok.io/voice/agent-join
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GHL
GHL_API_KEY=your_ghl_api_key_here
