__pycache__/
*.pyc
*.pyo

# Frontend build artifacts
node_modules/
dist/

# OS junk
.DS_Store

# Secrets — never commit
.env
.env.*
!.env.example
credentials.json
reauth_google.py

# Video render workspace and vendored skill cache — large/binary, regenerated locally
content-agent/projects/
content-agent/raw/
content-agent/exports/
content-agent/.agents/

# Playwright MCP debug artifacts (console logs, screenshots)
.playwright-mcp/

# leadgen-agent scrape run logs/intermediates
leadgen-agent/logs/

# Stray screenshots/scratch images dropped at repo root by agent tool use
# (browser screenshots, visual QA checks, etc.) — these belong in the
# session scratchpad, not the repo. Only blocks root-level files so
# legitimate image assets nested in project directories still commit.
/*.png
/*.jpg
/*.jpeg
